{
  "name": "euloge-arcade",
  "private": true,
  "version": "0.1.0",
  "description": "Euloge Arcade — plateforme de jeux sur navigateur créée par Euloge",
  "author": "Euloge",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed:sql": "node scripts/generate-seed.mjs",
    "brand:assets": "node scripts/render-brand-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.1.0",
    "@fontsource-variable/space-grotesk": "5.1.0",
    "@supabase/supabase-js": "2.117.3",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "postcss": "8.5.29",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
