# Copy to .env.local. Without these two values the platform runs in "local mode":
# the catalog comes from src/data/games.seed.json, favorites/history stay in the
# browser, and accounts/admin are disabled.
VITE_SUPABASE_URL=
# Public "anon"/publishable key only. NEVER put the service_role/secret key here.
VITE_SUPABASE_ANON_KEY=
